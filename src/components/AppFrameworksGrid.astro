---
import { CardGrid } from '@astrojs/starlight/components';
import FrameworkCard from './FrameworkCard.astro';

export interface Props {
  lang: 'js' | 'go' | 'dart' | 'python';
}

const { lang } = Astro.props;
const prefix = `/docs/${lang}/frameworks`;
---

<CardGrid>
  <FrameworkCard
    framework="nextjs"
    title="Next.js"
    description="Full-stack React with App Router, Pages Router, or a standalone Genkit backend."
    href={`${prefix}/nextjs/`}
  />
  <FrameworkCard
    framework="sveltekit"
    title="SvelteKit"
    description="Full-stack Svelte using SvelteKit API routes and the Genkit fetch handler."
    href={`${prefix}/sveltekit/`}
  />
  <FrameworkCard
    framework="nuxt"
    title="Nuxt"
    description="Full-stack Vue using Nitro server routes and the Genkit fetch handler."
    href={`${prefix}/nuxt/`}
  />
  <FrameworkCard
    framework="tanstack-start"
    title="TanStack Start"
    description="Full-stack React using TanStack Router with Vinxi API routes."
    href={`${prefix}/tanstack-start/`}
  />
  <FrameworkCard
    framework="astro"
    title="Astro"
    description="Content-driven sites using Astro SSR with API routes."
    href={`${prefix}/astro/`}
  />
  <FrameworkCard
    framework="angular"
    title="Angular"
    description="Angular SSR and hybrid-rendered applications."
    href={`${prefix}/angular/`}
  />
  <FrameworkCard
    framework="react"
    title="React (Vite)"
    description="Client-side React apps that connect to a standalone Genkit backend."
    href={`${prefix}/react/`}
  />
  <FrameworkCard
    framework="remix"
    title="Remix"
    description="Full-stack React using Remix resource routes and the Genkit fetch handler."
    href={`${prefix}/remix/`}
  />
  <FrameworkCard
    framework="flutter"
    title="Flutter"
    description="Mobile, desktop, and web apps using the Dart client SDK."
    href="/docs/frontend/flutter/"
  />
</CardGrid>
